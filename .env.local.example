# Copy to .env.local and fill in. All vars are NEXT_PUBLIC_* because the app is a
# static export (no server) — values are inlined into the client bundle at build time.
# Everything degrades gracefully: missing vars just disable the related feature.

# --- Supabase Auth + leaderboard ---
# Project URL + anon key from the Supabase dashboard (Settings > API).
# For social login, enable Google and Twitter providers in Authentication > Providers,
# and add your deployed URL (e.g. https://ranuk12.github.io/LigaStatsGame/) to the
# Redirect URLs under Authentication > URL Configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Live scores (opcional) ---
# Los resultados salen del sync server-side de Copero (scripts/data/fetch-live-scores.mjs,
# corre en cada build/cron), sin key ni CORS. Esta key de TheSportsDB es solo un top-up
# opcional en el cliente; dejala vacía si no la usás.
NEXT_PUBLIC_SPORTSDB_KEY=

# Donaciones: MercadoPago va hardcodeado en lib/donations.ts (links públicos), no usa env.

# --- Google Analytics 4 (opcional) ---
# ID de medición de la propiedad web: Admin > Flujos de datos > tu web ("G-XXXXXXXXXX").
# Vacío = no se carga ningún script de analítica.
NEXT_PUBLIC_GA_ID=
