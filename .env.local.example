# Copy to .env.local and fill in. All vars are NEXT_PUBLIC_* because the app is a
# static export (no server) — values are inlined into the client bundle at build time.
# Everything degrades gracefully: missing vars just disable the related feature.

# --- Supabase Auth + leaderboard ---
# Project URL + anon key from the Supabase dashboard (Settings > API).
# For social login, enable Google and Twitter providers in Authentication > Providers,
# and add your deployed URL (e.g. https://ranuk12.github.io/LigaStatsGame/) to the
# Redirect URLs under Authentication > URL Configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Live scores (TheSportsDB) ---
# The '3' test key is heavily scoped and returns almost nothing; use a real key.
# Without it, the Home widget falls back to public/data/live-scores.json.
NEXT_PUBLIC_SPORTSDB_KEY=

# --- Donations: MercadoPago (ARS) ---
# Alias shown/copied in the UI, and a preference/payment link (opens on click).
NEXT_PUBLIC_MP_ALIAS=
NEXT_PUBLIC_MP_LINK=
# Optional QR image: place it at public/donations/mp-qr.png

# --- Donations: Stripe (USD) ---
# Static Stripe Payment Links (no server needed). Create them at
# https://dashboard.stripe.com/payment-links
NEXT_PUBLIC_STRIPE_LINK_5=
NEXT_PUBLIC_STRIPE_LINK_10=
NEXT_PUBLIC_STRIPE_LINK_25=
